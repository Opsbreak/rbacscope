{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "rbacscope",
          "version": "0.1.0",
          "informationUri": "https://github.com/Opsbreak/rbacscope",
          "rules": [
            {
              "id": "RS001",
              "name": "cluster-admin-equivalent",
              "shortDescription": {
                "text": "Binding grants full wildcard access (*/*/*)"
              },
              "fullDescription": {
                "text": "The bound role allows every verb on every resource in every API group. Through a ClusterRoleBinding this is cluster-admin; through a RoleBinding it is full control of the namespace, including its secrets and service accounts."
              },
              "help": {
                "text": "The bound role allows every verb on every resource in every API group. Through a ClusterRoleBinding this is cluster-admin; through a RoleBinding it is full control of the namespace, including its secrets and service accounts.\n\nRemediation: Replace the wildcard rule with the specific verbs/resources required. Reserve cluster-admin for break-glass identities and bind it through short-lived, audited access."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "RS002",
              "name": "wildcard-rule",
              "shortDescription": {
                "text": "Rule uses wildcards for verbs, resources or API groups"
              },
              "fullDescription": {
                "text": "Wildcards automatically extend to subresources, new verbs and resources added by CRDs or future Kubernetes versions, so the effective permission silently grows over time."
              },
              "help": {
                "text": "Wildcards automatically extend to subresources, new verbs and resources added by CRDs or future Kubernetes versions, so the effective permission silently grows over time.\n\nRemediation: Enumerate the verbs, apiGroups and resources explicitly."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "RS003",
              "name": "rbac-escalate-bind",
              "shortDescription": {
                "text": "Subject can escalate or bind roles"
              },
              "fullDescription": {
                "text": "The escalate verb lets a subject create or update roles containing permissions it does not hold; bind lets it create bindings to roles it does not hold. Either bypasses RBAC privilege-escalation prevention (e.g. binding itself to cluster-admin)."
              },
              "help": {
                "text": "The escalate verb lets a subject create or update roles containing permissions it does not hold; bind lets it create bindings to roles it does not hold. Either bypasses RBAC privilege-escalation prevention (e.g. binding itself to cluster-admin).\n\nRemediation: Remove escalate/bind. If delegation is required, restrict bind with resourceNames to the specific low-privilege roles that may be delegated."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "RS004",
              "name": "impersonation",
              "shortDescription": {
                "text": "Subject can impersonate other identities"
              },
              "fullDescription": {
                "text": "impersonate on users, groups, uids or serviceaccounts lets the subject act as any of those identities, e.g. as a member of system:masters."
              },
              "help": {
                "text": "impersonate on users, groups, uids or serviceaccounts lets the subject act as any of those identities, e.g. as a member of system:masters.\n\nRemediation: Remove impersonate or restrict it with resourceNames to specific, low-privilege identities."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "RS005",
              "name": "workload-creation",
              "shortDescription": {
                "text": "Subject can create pods or modify workloads"
              },
              "fullDescription": {
                "text": "Anyone who can create pods (directly or through Deployments, DaemonSets, Jobs, ...) in a namespace can run a pod as ANY service account in that namespace and read its token, inheriting all of that service account's permissions. They can also mount secrets and configmaps of the namespace."
              },
              "help": {
                "text": "Anyone who can create pods (directly or through Deployments, DaemonSets, Jobs, ...) in a namespace can run a pod as ANY service account in that namespace and read its token, inheriting all of that service account's permissions. They can also mount secrets and configmaps of the namespace.\n\nRemediation: Grant workload creation only in namespaces whose service accounts are no more privileged than the subject. Keep privileged service accounts in dedicated namespaces; enforce Pod Security Admission and an admission policy restricting serviceAccountName."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "RS006",
              "name": "pod-exec-attach",
              "shortDescription": {
                "text": "Subject can exec/attach into pods"
              },
              "fullDescription": {
                "text": "pods/exec and pods/attach give a shell in running containers and therefore access to their mounted service account tokens, secrets and network position. (On clusters before 1.31, get on pods/exec also permits exec over WebSocket.)"
              },
              "help": {
                "text": "pods/exec and pods/attach give a shell in running containers and therefore access to their mounted service account tokens, secrets and network position. (On clusters before 1.31, get on pods/exec also permits exec over WebSocket.)\n\nRemediation: Remove pods/exec and pods/attach from routine roles; use just-in-time access for debugging."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "RS007",
              "name": "nodes-proxy",
              "shortDescription": {
                "text": "Subject can access the kubelet API via nodes/proxy"
              },
              "fullDescription": {
                "text": "nodes/proxy reaches the kubelet API, which allows running commands in any pod on the node and bypasses API server audit logging and admission."
              },
              "help": {
                "text": "nodes/proxy reaches the kubelet API, which allows running commands in any pod on the node and bypasses API server audit logging and admission.\n\nRemediation: Remove nodes/proxy. Monitoring agents should use the /metrics endpoints via nodes/metrics or the metrics API instead."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "RS008",
              "name": "secrets-read",
              "shortDescription": {
                "text": "Subject can read secrets"
              },
              "fullDescription": {
                "text": "get/list/watch on secrets exposes credentials, including legacy service account tokens. Note that list and watch return full secret contents. Cluster-wide read is equivalent to obtaining every credential stored in the cluster."
              },
              "help": {
                "text": "get/list/watch on secrets exposes credentials, including legacy service account tokens. Note that list and watch return full secret contents. Cluster-wide read is equivalent to obtaining every credential stored in the cluster.\n\nRemediation: Restrict secret access to specific namespaces and, where possible, specific resourceNames with get only."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "RS009",
              "name": "serviceaccount-token-create",
              "shortDescription": {
                "text": "Subject can mint service account tokens"
              },
              "fullDescription": {
                "text": "create on serviceaccounts/token issues a bound token for a service account, granting all of its permissions."
              },
              "help": {
                "text": "create on serviceaccounts/token issues a bound token for a service account, granting all of its permissions.\n\nRemediation: Remove serviceaccounts/token create or restrict it with resourceNames."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "RS010",
              "name": "csr-approve",
              "shortDescription": {
                "text": "Subject can create and approve certificate signing requests"
              },
              "fullDescription": {
                "text": "create on certificatesigningrequests plus update on certificatesigningrequests/approval (and approve on the kube-apiserver-client signer) lets the subject mint client certificates for any user or group, including system:masters."
              },
              "help": {
                "text": "create on certificatesigningrequests plus update on certificatesigningrequests/approval (and approve on the kube-apiserver-client signer) lets the subject mint client certificates for any user or group, including system:masters.\n\nRemediation: Separate CSR creation and approval duties; restrict approve on signers to specific signerNames via resourceNames."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "RS011",
              "name": "admission-webhook-write",
              "shortDescription": {
                "text": "Subject can modify admission webhook configurations"
              },
              "fullDescription": {
                "text": "Mutating webhooks can inject containers, service accounts or privileged settings into every pod created in the cluster; validating webhooks receive every admitted object, including secrets, and can deny traffic."
              },
              "help": {
                "text": "Mutating webhooks can inject containers, service accounts or privileged settings into every pod created in the cluster; validating webhooks receive every admitted object, including secrets, and can deny traffic.\n\nRemediation: Limit webhook configuration writes to the deployment pipeline identity."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "RS012",
              "name": "persistentvolume-create",
              "shortDescription": {
                "text": "Subject can create PersistentVolumes"
              },
              "fullDescription": {
                "text": "A PersistentVolume can point at a hostPath on a node; binding it to a claim gives pods access to the node filesystem regardless of Pod Security settings on hostPath volumes."
              },
              "help": {
                "text": "A PersistentVolume can point at a hostPath on a node; binding it to a claim gives pods access to the node filesystem regardless of Pod Security settings on hostPath volumes.\n\nRemediation: Use dynamic provisioning through StorageClasses and remove create on persistentvolumes."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "RS013",
              "name": "broad-group-binding",
              "shortDescription": {
                "text": "Binding grants permissions to all (un)authenticated users or all service accounts"
              },
              "fullDescription": {
                "text": "Subjects system:unauthenticated / system:anonymous apply to anyone who can reach the API server; system:authenticated applies to every identity including every service account in the cluster; system:serviceaccounts applies to every service account."
              },
              "help": {
                "text": "Subjects system:unauthenticated / system:anonymous apply to anyone who can reach the API server; system:authenticated applies to every identity including every service account in the cluster; system:serviceaccounts applies to every service account.\n\nRemediation: Bind to specific users, groups or service accounts."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "RS014",
              "name": "default-sa-privileged",
              "shortDescription": {
                "text": "Namespace default service account has permissions and is automounted"
              },
              "fullDescription": {
                "text": "Pods that do not set serviceAccountName run as \"default\". When that service account has RBAC permissions and the token is automounted, every such pod receives them."
              },
              "help": {
                "text": "Pods that do not set serviceAccountName run as \"default\". When that service account has RBAC permissions and the token is automounted, every such pod receives them.\n\nRemediation: Create a dedicated service account per workload, remove bindings from \"default\", and set automountServiceAccountToken: false on the default service account."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "RS015",
              "name": "cluster-admin-inventory",
              "shortDescription": {
                "text": "cluster-admin binding inventory"
              },
              "fullDescription": {
                "text": "Inventory of every binding to the cluster-admin ClusterRole (or an equivalent */*/* role), including built-in ones, for review."
              },
              "help": {
                "text": "Inventory of every binding to the cluster-admin ClusterRole (or an equivalent */*/* role), including built-in ones, for review.\n\nRemediation: Review periodically; every entry should be expected and owned."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "1.0",
                "precision": "high"
              }
            },
            {
              "id": "RS016",
              "name": "dangling-binding",
              "shortDescription": {
                "text": "Binding references a role that does not exist"
              },
              "fullDescription": {
                "text": "The binding grants nothing today, but whoever later creates a role with that name silently grants it to the binding's subjects."
              },
              "help": {
                "text": "The binding grants nothing today, but whoever later creates a role with that name silently grants it to the binding's subjects.\n\nRemediation: Delete the binding or create the intended role."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "3.0",
                "precision": "high"
              }
            },
            {
              "id": "RS017",
              "name": "pod-runs-as-admin-sa",
              "shortDescription": {
                "text": "Workload runs with a cluster-admin-equivalent service account token"
              },
              "fullDescription": {
                "text": "The pod mounts a token for a service account that is cluster-admin-equivalent. Compromise of any container in the pod (RCE, SSRF to the token file, exec) is full cluster compromise."
              },
              "help": {
                "text": "The pod mounts a token for a service account that is cluster-admin-equivalent. Compromise of any container in the pod (RCE, SSRF to the token file, exec) is full cluster compromise.\n\nRemediation: Give the workload a least-privilege service account, or disable automountServiceAccountToken if it does not call the API."
              },
              "helpUri": "https://github.com/Opsbreak/rbacscope#audit-rules",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "kubernetes",
                  "rbac"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            }
          ]
        }
      },
